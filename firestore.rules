rules_version = '2';

// Reglas de seguridad para Musicala - Calificacion de equipo
// Publicar en Firebase Console -> Firestore Database -> Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'alekcaballeromusic@gmail.com',
          'catalina.medina.leal@gmail.com'
        ];
    }

    function reviewValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['personId', 'stars', 'comment', 'createdAt'])
        && d.personId is string && d.personId.size() > 0 && d.personId.size() <= 120
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.comment is string && d.comment.size() <= 500
        && d.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      allow create: if reviewValido();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    function teamMemberValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'personId', 'name', 'role', 'section', 'sectionLabel', 'subarea',
          'tags', 'photoUrl', 'photoDataUrl', 'active', 'createdAt', 'createdBy'
        ])
        && d.personId is string && d.personId.size() > 0 && d.personId.size() <= 120
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.role is string && d.role.size() > 0 && d.role.size() <= 160
        && d.section is string && d.section.size() > 0 && d.section.size() <= 80
        && d.sectionLabel is string && d.sectionLabel.size() > 0 && d.sectionLabel.size() <= 120
        && d.subarea is string && d.subarea.size() <= 120
        && d.tags is list && d.tags.size() <= 12
        && d.photoUrl is string && d.photoUrl.size() <= 800
        && d.photoDataUrl is string && d.photoDataUrl.size() <= 900000
        && d.active is bool
        && d.createdAt == request.time
        && d.createdBy is string && d.createdBy.size() <= 180;
    }

    match /teamMembers/{memberId} {
      allow read: if true;
      allow create: if isAdmin() && teamMemberValido();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
